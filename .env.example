# Copy this file to .env:
# cp .env.example .env
#
# Do not commit .env. It contains real API keys.

# Option A: OpenAI
OPENAI_API_KEY=

# Option B: Anthropic
ANTHROPIC_API_KEY=

# Repo runtime settings
# Use "mock" for offline tests.
# Use "openai" for the Week 1 LLM router assignment.
LLM_PROVIDER=mock
LLM_MODEL=gpt-5.4-mini

# Bonus: OpenAI-compatible providers such as DeepSeek / Qwen / Zhipu
# These are not used by the current src code yet, but students can use them in Bonus work.
# Uncomment only when using an OpenAI-compatible provider.
# The value must include https://
# OPENAI_BASE_URL=https://api.openai.com/v1
